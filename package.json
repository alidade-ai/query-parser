{
  "name": "@alidade/query-parser",
  "version": "0.0.0",
  "description": "Fast Tantivy boolean query parser with diagnostics for validation and linting",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "browser": "browser.js",
  "files": [
    "index.d.ts",
    "index.js",
    "browser.js"
  ],
  "napi": {
    "binaryName": "query-parser",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "initialMemory": 1024,
      "maximumMemory": 4096,
      "browser": {
        "fs": false
      }
    }
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "preversion": "napi build --platform && git add .",
    "version": "napi version",
    "format": "pnpm run format:prettier && pnpm run format:rs && pnpm run format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "tombi format",
    "format:rs": "cargo fmt",
    "lint": "oxlint .",
    "test": "ava"
  },
  "devDependencies": {
    "@emnapi/core": "^1.7.1",
    "@emnapi/runtime": "^1.7.1",
    "@napi-rs/cli": "^3.5.0",
    "@napi-rs/wasm-runtime": "^1.1.0",
    "@oxc-node/core": "^0.0.35",
    "@tybys/wasm-util": "^0.10.1",
    "ava": "^6.4.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.32.0",
    "prettier": "^3.7.4",
    "tombi": "^0.7.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "packageManager": "pnpm@10.19.0"
}
